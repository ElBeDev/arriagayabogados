# Copia este archivo a .env.local (desarrollo) o carga las variables en Vercel.

# --- Base de datos (Neon vía integración de Vercel; en local, Postgres) ---
DATABASE_URL=postgres://usuario@localhost:5432/arriaga_abogados

# --- Panel /admin ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Opcional: cuenta de editor (solo publicaciones)
EDITOR_USERNAME=
EDITOR_PASSWORD=
# Secreto largo y aleatorio para firmar la sesión: openssl rand -hex 32
SESSION_SECRET=

# --- Imágenes subidas desde /admin (Vercel Blob). Sin esto, en local se guardan en public/subidas ---
BLOB_READ_WRITE_TOKEN=

# --- Correo de prospectos (Resend). Sin esto, los prospectos solo se guardan en la base ---
RESEND_API_KEY=
RESEND_FROM="Arriaga & Abogados <notificaciones@arriagayabogados.com>"
# Respaldo si el área no tiene responsable
LEADS_TO=contacto@arriagayabogados.com

# --- Anti-spam (Cloudflare Turnstile). Sin esto no se muestra el captcha ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analítica (Google Analytics 4). Sin esto no hay banner de cookies ni GA ---
NEXT_PUBLIC_GA_ID=

# --- Agenda en línea (Cal.com), p. ej. https://cal.com/arriaga-abogados/consulta ---
NEXT_PUBLIC_CALCOM_URL=

# --- Tarea diaria que borra prospectos de más de 12 meses (Vercel Cron) ---
CRON_SECRET=
